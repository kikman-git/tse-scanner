# Data source: 'free' (JPX published files + Yahoo — DEFAULT until PLAN.md Track B lands) or
# 'jquants' (paid Standard, subscribed 2026-06; wiring in progress). See DESIGN.md §5.
TSE_DATA_SOURCE=free

# Local store (DESIGN.md §8)
TSE_DATA_DIR=./data
TSE_DUCKDB_PATH=./data/tse.duckdb

# --- J-Quants API V2 (Standard tier, active subscription) ---------------------------------------
# Auth is a single API key issued from the dashboard (jpx-jquants.com), sent as the `x-api-key`
# header against https://api.jquants.com/v2 — the old email/password → refresh-token flow is
# V1-only and retired. Standard = per-issue weekly margin (信用取引週末残高, ~10yr) +
# 空売り残高報告 + daily bars. Ingestion wiring = PLAN.md Track B.
JQUANTS_API_KEY=

# Optional fresher fuel (DESIGN.md §4, Phase 4): 日証金 / JSF daily 貸借 + 逆日歩
JSF_ENABLED=false

# --- Deep research: on-demand per-ticker fundamental memo (DESIGN.md §15) -----------------------
# Spawns the local `claude` CLI headless; synthesis model below, collectors pinned to sonnet.
TSE_RESEARCH_MODEL=claude-fable-5
TSE_RESEARCH_TTL_DAYS=5
TSE_RESEARCH_TIMEOUT_S=900
TSE_RESEARCH_MAX_TURNS=50
TSE_CLAUDE_BIN=claude
